{
  "name": "@minecraft-server/shared",
  "private": true,
  "type": "module",
  "exports": {
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.js"
    },
    "./auth": {
      "types": "./dist/features/auth/index.d.ts",
      "import": "./dist/features/auth/index.js"
    },
    "./invitations": {
      "types": "./dist/features/invitations/index.d.ts",
      "import": "./dist/features/invitations/index.js"
    },
    "./minecraft": {
      "types": "./dist/features/minecraft/index.d.ts",
      "import": "./dist/features/minecraft/index.js"
    },
    "./users": {
      "types": "./dist/features/users/index.d.ts",
      "import": "./dist/features/users/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsc-alias": "^1.9.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  }
}
