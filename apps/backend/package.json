{
  "name": "@minecraft-server/backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "test": "vitest",
