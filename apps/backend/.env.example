# backend/env.example

SESSION_SECRET=secret
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_DOMAIN=

SESSION_TTL_DAYS=7
CSRF_TTL_DAYS=7
INVITATION_TTL_DAYS=7

GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Host-dev default (the controller's loopback publish); compose overrides it
# to http://minecraft-controller:8000 inside the network. The token comes from
# the root .env — never duplicate it here.
MINECRAFT_CONTROLLER_URL=http://localhost:8001

BOOTSTRAP_EMAIL=owner@domain.com