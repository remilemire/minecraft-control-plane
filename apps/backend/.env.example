# apps/backend/.env.example

# Required by config/env.ts but currently unused (sessions store hashed
# random tokens, no signing) — kept until it is removed or repurposed.
SESSION_SECRET=secret

SESSION_TTL_DAYS=7
CSRF_TTL_DAYS=7
INVITATION_TTL_DAYS=7

# GOOGLE_CLIENT_ID lives in the root .env (the prod image build needs it at
# compose-interpolation level) — never duplicate it here.

# Host-dev default (the controller's loopback publish); compose overrides it
# to http://minecraft-controller:8000 inside the network. The token comes from
# the root .env — never duplicate it here.
MINECRAFT_CONTROLLER_URL=http://localhost:8001

BOOTSTRAP_EMAIL=owner@domain.com
