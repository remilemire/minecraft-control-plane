{
  "name": "@minecraft-control-plane/minecraft-controller",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "rm -rf dist && tsc --build tsconfig.build.json --force && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:drill": "tsx test/docker-drill.ts"
  },
  "dependencies": {
    "@minecraft-control-plane/shared": "workspace:*",
    "croner": "^10.0.1",
    "dockerode": "^4.0.9",
    "express": "^5.2.1",
    "tar-stream": "^3.2.1",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.42",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.0",
    "@types/tar-stream": "^3.1.4",
    "@types/yauzl": "^3.4.0",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.22.4",
    "vitest": "^4.1.9"
  }
}
