# .env.example

APP_ENV=dev # dev | prod

BACKEND_PORT=8000
FRONTEND_PORT=5173 # dev only (Vite dev server publish)

POSTGRES_PORT=5432 # dev-only host publish; keep 5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_HOST=db
POSTGRES_DATABASE=minecraft_server

# Google OAuth client id (public — it ships in the SPA bundle). Read by the
# backend, and baked into the prod image's frontend build as
# VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com

# Prod only: the public hostname of the panel — must match its DNS record and
# the Google console's authorized JavaScript origin.
CADDY_SITE_ADDRESS=mc.example.com

MINECRAFT_RCON_HOST=minecraft
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=password

MINECRAFT_VERSION= # Leave undefined when TYPE = FTBA
MINECRAFT_TYPE=FTBA # VANILLA | PAPER | FTBA
MINECRAFT_DIFFICULTY=HARD # PEACEFUL | EASY | NORMAL | HARD
MINECRAFT_MODE=SURVIVAL # SURVIVAL | CREATIVE
MINECRAFT_MEMORY=2G
MINECRAFT_LEVEL=world

# Optional: leave undefined unless running an FTB modpack server.
MINECRAFT_FTB_MODPACK_ID=
MINECRAFT_FTB_MODPACK_VERSION_ID=

MINECRAFT_COMPOSE_PROJECT=minecraft-control-plane
MINECRAFT_CONTROLLER_PORT=8001
MINECRAFT_CONTROLLER_TOKEN=change-me
